@model POS.Models.DTOs.ProductRequestDto

@{
    ViewData["Title"] = "Edit Product";
}

<div class="container mt-4">

    <h2>Edit Product</h2>

    <div asp-validation-summary="All"
         class="text-danger mb-3">
    </div>

    <form asp-action="Edit"
          asp-route-id="@ViewBag.ProductId"
          method="post">

        @Html.AntiForgeryToken()

        <div class="mb-3">
            <label asp-for="Name" class="form-label">
                Product Name
            </label>

            <input asp-for="Name"
                   class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="SKU" class="form-label">
                SKU
            </label>

            <input asp-for="SKU"
                   class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="Category" class="form-label">
                Category
            </label>

            <input asp-for="Category"
                   class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="Price" class="form-label">
                Price
            </label>

            <input asp-for="Price"
                   type="number"
                   step="0.01"
                   class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="StockQuantity" class="form-label">
                Stock Quantity
            </label>

            <input asp-for="StockQuantity"
                   type="number"
                   class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="LowStockThreshold" class="form-label">
                Low Stock Threshold
            </label>

            <input asp-for="LowStockThreshold"
                   type="number"
                   class="form-control" />
        </div>

        <button type="submit"
                class="btn btn-primary">
            Update Product
        </button>

        <a asp-action="Index"
           class="btn btn-secondary">
            Cancel
        </a>

    </form>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}