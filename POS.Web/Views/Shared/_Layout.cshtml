<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - POS Billing System</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/POS.Web.styles.css"
          asp-append-version="true" />
</head>

<body class="bg-light">

    <!-- Navigation -->
    <header>

        <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm">

            <div class="container-fluid px-4">

                <!-- Application Name -->
                <a class="navbar-brand fw-bold"
                   asp-controller="Billing"
                   asp-action="Index">
                    POS Billing System
                </a>

                <!-- Mobile Menu Button -->
                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar"
                        aria-expanded="false"
                        aria-label="Toggle navigation">

                    <span class="navbar-toggler-icon"></span>

                </button>

                <!-- Navigation Menu -->
                <div class="collapse navbar-collapse"
                     id="mainNavbar">

                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">

                        <!-- Billing -->
                        <li class="nav-item">

                            <a class="nav-link"
                               asp-controller="Billing"
                               asp-action="Index">

                                Billing

                            </a>

                        </li>

                        <!-- Products -->
                        <li class="nav-item">

                            <a class="nav-link"
                               asp-controller="Product"
                               asp-action="Index">

                                Products

                            </a>

                        </li>

                        <!-- Orders -->
                        <li class="nav-item">

                            <a class="nav-link"
                               asp-controller="Order"
                               asp-action="Index">

                                Orders

                            </a>

                        </li>

                        <!-- Low Stock -->
                        <li class="nav-item">

                            <a class="nav-link"
                               asp-controller="Product"
                               asp-action="LowStock">

                                Low Stock

                            </a>

                        </li>

                        <!-- Reports -->
                        <li class="nav-item">

                            <a class="nav-link"
                               asp-controller="Order"
                               asp-action="Reports">

                                Reports

                            </a>

                        </li>

                    </ul>

                    <!-- Right Side -->
                    <span class="navbar-text text-light">

                        POS Management

                    </span>

                </div>

            </div>

        </nav>

    </header>


    <!-- Main Content -->
    <main>

        <div class="container-fluid px-4 py-4">

            @RenderBody()

        </div>

    </main>


    <!-- Footer -->
    <footer class="border-top bg-white mt-5">

        <div class="container-fluid px-4 py-3">

            <div class="row">

                <div class="col-md-6">

                    <span class="text-muted">

                        © 2026 POS Billing & Inventory Management System

                    </span>

                </div>

                <div class="col-md-6 text-md-end">

                    <span class="text-muted">

                        Billing | Inventory | Payments | Reports

                    </span>

                </div>

            </div>

        </div>

    </footer>


    <!-- JavaScript -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>